<div id="sidebar_plugin_fanrpm" class="fanrpm-sidebar">
    Current: <i class="fa fa-fan" data-bind="css: fanIconClass"></i> <strong><span data-bind="text: currentRPM, css: rpmStatusClass"></span> <span data-bind="css: rpmStatusClass">RPM</span></strong><br>
    <hr style="margin: 8px 0;">
    <div class="btn-group btn-group-xs" data-toggle="buttons-radio" style="margin-bottom: 8px;">
        <button type="button" class="btn btn-default btn-mini" data-bind="css: { active: timeWindow() === '1min' }, click: function() { setTimeWindow('1min'); }">1 min</button>
        <button type="button" class="btn btn-default btn-mini" data-bind="css: { active: timeWindow() === '5min' }, click: function() { setTimeWindow('5min'); }">5 min</button>
        <button type="button" class="btn btn-default btn-mini" data-bind="css: { active: timeWindow() === '30min' }, click: function() { setTimeWindow('30min'); }">30 min</button>
    </div><br>
    <div style="position: relative; width: 100%; height: 150px; margin-bottom: 8px;">
        <div id="fanrpm-graph" style="width: 100%; height: 100%;"></div>
        <div class="fanrpm-stats-overlay">
            Avg: <strong><span data-bind="text: averageRPM, css: averageRPMStatusClass"></span></strong>
            Min: <strong><span data-bind="text: minRPM, css: minRPMStatusClass"></span></strong>
            Max: <strong><span data-bind="text: maxRPM, css: maxRPMStatusClass"></span></strong>
        </div>
    </div>

    <style>
        .fanrpm-sidebar .rpm-status-ok {
            color: #468847;
        }

        .fanrpm-sidebar .rpm-status-warning {
            color: #f89406;
        }

        .fanrpm-sidebar .rpm-status-danger {
            color: #b94a48;
        }

        /* Normal speed - 2s */
        .fanrpm-sidebar .fan-spin-ok {
            animation: fa-spin 2s infinite linear;
        }

        /* Half speed - 4s */
        .fanrpm-sidebar .fan-spin-warning {
            animation: fa-spin 4s infinite linear;
        }

        /* Quarter speed - 8s */
        .fanrpm-sidebar .fan-spin-slow {
            animation: fa-spin 8s infinite linear;
        }

        /* No spin for 0 RPM */
        .fanrpm-sidebar .fan-spin-stop {
            /* no animation */
        }

        /* Statistics overlay on graph */
        .fanrpm-sidebar .fanrpm-stats-overlay {
            position: absolute;
            bottom: 30px;
            left: 35px;
            padding: 4px 8px;
            border-radius: 3px;
            font-size: 11px;
            line-height: 1.4;
            pointer-events: none;
        }
    </style>
</div>
